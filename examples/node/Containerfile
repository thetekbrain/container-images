# syntax=docker/dockerfile:1.29.0@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

# In eigenen App-Repos BASE_IMAGE per Digest pinnen:
#   FROM ghcr.io/thetekbrain/images/node:24.22.3@sha256:<digest>
ARG BASE_IMAGE=ghcr.io/thetekbrain/images/node:24.22.3

# Build-Stage: gleiche Node-Version wie die Runtime, auf der Zielplattform, damit native
# Addons zur glibc und Architektur passen (node:24.22.3-trixie-slim beruht auf Debian 13.8).
FROM node:24.22.3-trixie-slim@sha256:4d00acb4bcc42c454c4eb801526f7ad7f772ea3bd4fd168c5cc2e384abcbb9d4 AS build
ARG SOURCE_DATE_EPOCH
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY app.js index.html ./
RUN find /app -exec touch -h -d "@${SOURCE_DATE_EPOCH:-0}" {} +

FROM ${BASE_IMAGE}
WORKDIR /app
COPY --from=build /app /app
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --start-interval=1s CMD ["/usr/local/bin/node", "/app/app.js", "healthcheck"]
CMD ["/app/app.js"]
